<article class="classifieds-list-item classifieds-list-item--compact">
    <div class="classifieds-list-item__main">
        <h3 class="ad-list-title">{title}</h3>
        <p class="ad-list-price">{price} {currency}</p>
        <p class="ad-list-location">{cat}</p>
    </div>

    <div class="classifieds-list-item__image">
        {small_pic}
    </div>

    <div class="classifieds-list-item__date">
        <span>{date}</span>
        <span>{time}</span>
    </div>
</article>
