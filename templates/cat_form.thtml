<form action="{site_admin_url}/plugins/classifieds/index.php?mode=cat&amp;op=save" method="post" class="classifieds-form">
    {cid}

    <fieldset class="classifieds-form__section">
        <legend>{cat_informations}</legend>

        <div class="classifieds-form__field">
            <label for="classifieds-parent-category">{parent_category_label}</label>
            <select id="classifieds-parent-category" name="pid">
                {categories}
            </select>
            <p class="classifieds-form__help">{root_category_help}</p>
        </div>

        <div class="classifieds-form__field">
            <label for="classifieds-category-name">{category_label} <span class="classifieds-required">*</span></label>
            <input id="classifieds-category-name" type="text" name="category" value="{category}" maxlength="255" required{xhtml}>
        </div>

        <div id="classifieds-category-position-field" class="classifieds-form__field">
            <label for="classifieds-category-position">{child_position_label}</label>
            <select id="classifieds-category-position" name="position">
                {child_position_options}
            </select>
        </div>

        <div class="classifieds-form__field">
            <label for="classifieds-category-status">{catdeleted_label}</label>
            <select id="classifieds-category-status" name="catdeleted">
                <option value="0"{select_enable}>{enable}</option>
                <option value="1"{select_disable}>{disable}</option>
            </select>
        </div>
    </fieldset>

    <fieldset class="classifieds-form__section">
        <legend>{seo_metadata_label}</legend>

        <div class="classifieds-form__field">
            <label for="classifieds-meta-title">{meta_title_label}</label>
            <input id="classifieds-meta-title" type="text" name="meta_title" value="{meta_title}" maxlength="255"{xhtml}>
        </div>

        <div class="classifieds-form__field">
            <label for="classifieds-meta-description">{meta_description_label}</label>
            <textarea id="classifieds-meta-description" name="meta_description" rows="3" maxlength="160">{meta_description}</textarea>
        </div>

        <div class="classifieds-form__field">
            <label for="classifieds-meta-keywords">{meta_keywords_label}</label>
            <input id="classifieds-meta-keywords" type="text" name="meta_keywords" value="{meta_keywords}" maxlength="255"{xhtml}>
        </div>
    </fieldset>

    <p class="classifieds-form__required"><span class="classifieds-required">*</span> {required_field}</p>

    <div class="classifieds-form__actions">
        <input type="submit" name="submit" value="{validate_button}"{xhtml}>
        {delete_action}
    </div>

    <input type="hidden" name="{gltoken_name}" value="{gltoken}"{xhtml}>
</form>
