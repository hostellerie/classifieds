    </div>

    <div {list-legend}>
        <span class="classifieds-legend__item"><span class="ad-list-active"></span>{ad-list-active}</span>
        <span class="classifieds-legend__item"><span class="ad-list-old"></span>{ad-list-old}</span>
        <span class="classifieds-legend__item"><span class="ad-list-deleted"></span>{ad-list-delete}</span>
    </div>

    <div class="classifieds-pagination">{pagination}</div>
</div>
