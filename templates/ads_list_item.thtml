<article{class}>
    <div class="classifieds-list-item__date">
        <span>{date}</span>
        <span>{time}</span>
    </div>

    <div class="classifieds-list-item__image">
        {small_pic}
    </div>

    <div class="classifieds-list-item__main">
        <h3 class="ad-list-title">{title} {edit}</h3>
        <p class="ad-list-price">{price} {currency}</p>
        <p class="ad-list-location">{cat} · {postcode} {city}</p>
    </div>

    {views}
</article>
