<article{class}>
    <div class="classifieds-list-item__image">
        {small_pic}
    </div>

    <div class="classifieds-list-item__main">
        <h2 class="ad-list-title">{title} {edit}</h2>
        <div class="classifieds-list-item__meta">
            <span class="ad-list-location">{cat} · {postcode} {city}</span>
            <span class="classifieds-list-item__date">{date}</span>
        </div>
    </div>

    {price_display}
    {views}
</article>
