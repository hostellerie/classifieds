<form action="{site_url}/index.php?mode=e&amp;op=save" method="post" enctype="multipart/form-data" class="classifieds-form">
    {clid}

    <fieldset class="classifieds-form__section">
        <legend>{your_ad}</legend>

        <div class="classifieds-form__row">
            <div class="classifieds-form__field">
                <label for="classifieds-category">{category_label}</label>
                <select id="classifieds-category" name="catid">
                    {categories}
                </select>
            </div>

            <div class="classifieds-form__field">
                <label for="classifieds-type">{type_label}</label>
                <select id="classifieds-type" name="type" required>
                    {choose_type}
                    <option value="0"{type_o}>{offer}</option>
                    <option value="1"{type_d}>{demand}</option>
                </select>
            </div>
        </div>

        <div class="classifieds-form__field">
            <label for="classifieds-title">{title_label} <span class="classifieds-required">*</span></label>
            <input id="classifieds-title" type="text" name="title" value="{title}" maxlength="255" required{xhtml}>
        </div>

        <div class="classifieds-form__field">
            <label for="classifieds-text">{text_label} <span class="classifieds-required">*</span></label>
            <textarea id="classifieds-text" name="text" rows="12" required>{text}</textarea>
        </div>

        <div class="classifieds-form__field">
            <label for="classifieds-price">{price_label}</label>
            <div class="classifieds-form__inline">
                <input id="classifieds-price" type="text" name="price" value="{price}" maxlength="20"{xhtml}>
                <span>{currency}</span>
            </div>
        </div>
    </fieldset>

    <fieldset class="classifieds-form__section">
        <legend>{images}</legend>

        <div class="classifieds-form__images">
            <div class="classifieds-image-existing">
                {saved_images}
            </div>

            <div class="classifieds-image-upload" data-classifieds-image-upload data-max-files="{image_upload_max}">
                <label class="classifieds-image-upload__button" for="classifieds-images">
                    {image_upload_label}
                </label>
                <input
                    id="classifieds-images"
                    class="classifieds-image-upload__input"
                    type="file"
                    name="images[]"
                    accept="image/jpeg,image/png,image/gif"
                    multiple{image_upload_disabled}{xhtml}
                >
                <p class="classifieds-image-upload__help">{image_upload_help}</p>
                <div class="classifieds-image-upload__preview" data-classifieds-image-preview aria-live="polite"></div>
            </div>
        </div>
    </fieldset>

    <fieldset class="classifieds-form__section">
        <legend>{your_details}</legend>

        <div class="classifieds-form__field">
            <label for="classifieds-status">{status_label} <span class="classifieds-required">*</span></label>
            <select id="classifieds-status" name="status" required>
                {choose_status}
                <option value="0"{pro_no}>{private}</option>
                <option value="1"{pro_yes}>{professional}</option>
            </select>
        </div>

        <div id="siren" class="classifieds-form__field">
            <label for="classifieds-siren">{siren_label}</label>
            <input id="classifieds-siren" type="text" name="siren" value="{siren}" maxlength="40"{xhtml}>
        </div>

        <div class="classifieds-form__field">
            <label for="classifieds-tel">{tel_label} <span class="classifieds-required">*</span></label>
            <input id="classifieds-tel" type="tel" name="tel" value="{tel}" maxlength="20" required{xhtml}>
            <label class="classifieds-form__check">
                <input type="checkbox" name="hide_tel" value="1"{tel_ckecked}{xhtml}>
                {hide_tel_label}
            </label>
        </div>

        <div class="classifieds-form__row">
            <div class="classifieds-form__field">
                <label for="classifieds-postcode">{postcode_label} <span class="classifieds-required">*</span></label>
                <input id="classifieds-postcode" type="text" name="postcode" value="{postcode}" maxlength="20" required{xhtml}>
            </div>

            <div class="classifieds-form__field">
                <label for="classifieds-city">{city_label} <span class="classifieds-required">*</span></label>
                <input id="classifieds-city" type="text" name="city" value="{city}" maxlength="30" required{xhtml}>
            </div>
        </div>
    </fieldset>

    <p class="classifieds-form__required"><span class="classifieds-required">*</span> {required_field}</p>

    <div class="classifieds-form__meta">
        {created}
        {modified}
    </div>

    <div class="classifieds-form__actions">
        <input type="submit" name="submit" value="{validate_button}"{xhtml}>
    </div>

    <input type="hidden" name="{gltoken_name}" value="{gltoken}"{xhtml}>
</form>
